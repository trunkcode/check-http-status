{
	"name": "check-http-status",
	"description": "Crawl a website or check a list of URLs: HTTP status codes, redirect chains, broken links and the pages they were found on. Export to Excel, CSV, JSON or an HTML report.",
	"version": "2.0.0",
	"main": "index.js",
	"types": "index.d.ts",
	"bin": {
		"check-http-status": "bin/check-http-status.js"
	},
	"files": [
		"LICENSE",
		"index.js",
		"index.d.ts",
		"schema.json",
		"bin/*",
		"lib/**/*",
		"examples/*"
	],
	"engines": {
		"node": ">=18.17"
	},
	"runkitExampleFilename": "examples/runkit.js",
	"scripts": {
		"build:demo": "node scripts/build-demo.js",
		"lint": "eslint .",
		"test": "node --test",
		"test:types": "tsc -p test-d"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/trunkcode/check-http-status.git"
	},
	"keywords": [
		"http status",
		"redirect chain",
		"link checker",
		"broken links",
		"crawler",
		"site crawler",
		"sitemap",
		"seo",
		"status",
		"redirects",
		"301",
		"404"
	],
	"author": "TrunkCode <support@trunkcode.com> (https://www.trunkcode.com/)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/trunkcode/check-http-status/issues"
	},
	"homepage": "https://trunkcode.github.io/check-http-status/",
	"dependencies": {
		"cheerio": "^1.0.0",
		"exceljs": "^4.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.4",
		"eslint": "^10.11.0",
		"globals": "^17.13.0",
		"typescript": "^7.0.2"
	}
}
